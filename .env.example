# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# Required.
DATABASE_DSN=postgres://identity:identity@localhost:5432/identity?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Ports: gRPC, and plain HTTP for /livez and /readyz.
GRPC_PORT=9090
PROBE_PORT=8080

# Ory Kratos admin API: local accounts, passwords and sessions. Off when unset.
KRATOS_ADMIN_URL=http://localhost:4434
# How often a session's last-seen time moves while it is in use.
SESSION_LAST_SEEN_THROTTLE=1m
# Ory Polis admin API: organisations' SSO connections. Off when unset.
POLIS_ADMIN_URL=http://localhost:5225
POLIS_API_KEY=
GATEWAY_BASE_URL=http://localhost:5173

# Service-to-service authentication. Local runs switch it off; readiness then
# reports workloadauth degraded. In a cluster, drop WORKLOAD_AUTH and set the
# issuer, CA file, bearer file and allow-list instead (never both).
WORKLOAD_AUTH=disabled
# WORKLOAD_OIDC_ISSUER=https://kubernetes.default.svc.cluster.local
# WORKLOAD_OIDC_CA_FILE=/var/run/secrets/steward/kube-ca/ca.crt
# WORKLOAD_OIDC_BEARER_FILE=/var/run/secrets/steward/jwks/token
# WORKLOAD_ALLOWED_SERVICEACCOUNTS=steward/steward-gateway,steward/steward-workflow,steward/steward-obligations,steward/steward-reporting,steward/steward-collab,steward/steward-identity
# Identity's own token, sent to core. Unset with auth disabled sends none.
# WORKLOAD_TOKEN_FILE=/var/run/secrets/steward/token

# steward-core, for merge and the delete checks. Unset makes them fail closed.
CORE_GRPC_ADDR=localhost:9091
# steward-workflow (the delete's approval check, merges) and steward-obligations
# (merges). Unset makes them fail closed.
WORKFLOW_GRPC_ADDR=localhost:9093
OBLIGATIONS_GRPC_ADDR=localhost:9094

# 32 random bytes, hex or base64. Encrypts stored authenticator secrets.
TOTP_ENC_KEY=

# Email for one-time codes (go-email reads SMTP_*). A local catcher needs no
# credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.org
# Log one-time codes instead of relying on mail, for local development only.
OTP_DEV_ECHO=true

# Optional: the identity provider group cache (Redis or Valkey).
REDIS_ADDR=
